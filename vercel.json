{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/audit",
      "dest": "/api/audit.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/styles.css",
      "dest": "/styles.css"
    },
    {
      "src": "/why-geo/?",
      "dest": "/why-geo.html"
    },
    {
      "src": "/pricing/?",
      "dest": "/pricing.html"
    },
    {
      "src": "/run-report/?",
      "dest": "/run-report.html"
    },
    {
      "src": "/account/?",
      "dest": "/account.html"
    },
    {
      "src": "/llms.txt",
      "dest": "/llms.txt"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
