# Builder Rank local development
PORT=4174

# AI report-card analysis. Leave blank to use local heuristic scoring.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-5.2
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-2.5-flash

# Meta AI Visibility benchmark. The base URL and model are intentionally configurable
# because Meta Model API is in public preview and account endpoints/models may vary.
META_MODEL_API_KEY=
META_MODEL_API_BASE_URL=
META_MODEL=
META_MODEL_TIMEOUT_MS=45000
META_BENCHMARK_MAX_RUNS=5
# Enable only when the configured Meta-compatible provider supports this tool type.
META_MODEL_WEB_SEARCH_ENABLED=false

# Supabase Auth, saved reports, connected dashboard, and Site Signal storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe paid report reconciliation.
STRIPE_WEBHOOK_SECRET=
STRIPE_ADDITIONAL_REPORT_PAYMENT_URL=

# Report delivery.
RESEND_API_KEY=
REPORT_EMAIL_FROM=Builder Rank <Support@builderrank.io>
REPORT_EMAIL_REPLY_TO=Support@builderrank.io
REPORT_EMAIL_BCC=

# CRM/private beta sync.
HUBSPOT_ACCESS_TOKEN=

# Connected marketing platform beta.
# Generate production-owned values with: npm run production:secrets
TRACKING_HASH_SALT=generate-a-strong-random-value-before-production
ADMIN_API_TOKEN=generate-a-strong-random-admin-token-before-production
ADMIN_ALLOWED_ORIGIN=https://builderrank.io
# Sends stale Site Signal, domain mismatch, and missing lead-event QA alerts.
TRACKING_ALERT_EMAIL_TO=
MAX_JSON_BODY_BYTES=1000000
